# Copy to .env.local, then restart Vite. These values are public browser configuration.
VITE_API_MODE=demo
# success | validation | unavailable
VITE_DEMO_SCENARIO=success
# In real mode: origin of the Spring Boot server (empty means same origin).
VITE_API_BASE_URL=http://localhost:8080
VITE_API_TIMEOUT_MS=15000
